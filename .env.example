# ===== HuhmINK LINE Bot 環境變數 =====

# LINE Messaging API（必填）
# 到 https://developers.line.biz/ 的 Messaging API channel 取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# HuhmINK API（必填）
# 先到 https://l.huhm.cc/howto 免費申請一組金鑰
HUHMINK_API_KEY=

# 管理員的 LINE User ID（U 開頭，選填）
# 設定後「求救」服務單會推播轉交管理員；管理員需先把機器人加為好友
# 在 Developers Console → channel → Basic settings → Your user ID 可查到
ADMIN_LINE_USER_ID=

# HuhmINK API 端點（選填，預設 https://l.huhm.cc/api/v1/shorten）
# HUHMINK_API_URL=https://l.huhm.cc/api/v1/shorten

# 長駐模式的埠號（選填，預設 3000）
# PORT=3000
